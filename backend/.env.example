# Para visualizar a loja integrada com SQLite temporário e dados fictícios,
# sem modificar seu .env: npm --prefix testes run local (na raiz do projeto).
# Instruções e limites em LANCAMENTO.md.
# Estes padrões são de desenvolvimento. No servidor público use APP_ENV=production,
# APP_DEBUG=false, URLs HTTPS e LOCAL_TEST_MODE=false. Consulte DEPLOYMENT.md.
APP_NAME="Pruma Essential"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000
# Origens autorizadas para sessão SPA, sem protocolo. Ajuste aos domínios reais.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Somente IPs/faixas CIDR dos proxies informados pela hospedagem; vazio sem proxy.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL para desenvolvimento integrado/hospedagem; testes e prévia usam SQLite isolado.
# Configure um banco vazio dedicado. Ver MYSQL.md antes de migrar dados existentes.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pruma_essential
DB_USERNAME=pruma_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Conexão remota: CA do provedor no servidor e verificação de identidade habilitada.
MYSQL_ATTR_SSL_CA=
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Sem override, cookies Secure são ativados quando APP_ENV=production.
# Em homologação com HTTPS e outro APP_ENV, configure SESSION_SECURE_COOKIE=true.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log é apenas local e não entrega mensagens. Configure transporte real no servidor.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# false consulta as integrações configuradas. true simula frete/pagamento só em APP_ENV=local.
# O launcher de testes usa seu próprio ambiente isolado; não lê os tokens deste arquivo.
LOCAL_TEST_MODE=false

# Cotação Melhor Envio: token do mesmo ambiente, somente no backend. Ver MELHOR_ENVIO.md.
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_TOKEN=
STORE_ORIGIN_CEP=
# Preencha com o nome da aplicação e um email técnico real: "Nome da loja (email)".
MELHOR_ENVIO_USER_AGENT=

# Checkout Transparente via Orders. Public Key é pública; Access Token somente no backend.
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# URL HTTPS do webhook; Orders exige também configurar o tópico Order no provedor.
# A variável é usada pelo fluxo legado Checkout Pro.
MERCADO_PAGO_WEBHOOK_URL=
STORE_PICKUP_ENABLED=false
# Habilite retirada somente após informar local e orientações reais.
STORE_PICKUP_INSTRUCTIONS=

# Consulta de endereço: viacep dispensa token. Para Correios, selecione correios e configure o token.
POSTAL_CODE_PROVIDER=viacep
# API Busca CEP dos Correios opcional: token/chave subdelegada somente no servidor.
# Exige serviço 86738 no contrato. Configuração e renovação: CORREIOS_CEP.md.
CORREIOS_ACCESS_TOKEN=
