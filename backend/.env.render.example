# Modelo para variáveis do serviço Laravel no Render; não contém credenciais.
# Preencha APP_KEY estável e DB_URL somente no painel Environment do backend.
APP_NAME="PRUMA ESSENTIAL"
APP_ENV=production
APP_DEBUG=false
LOCAL_TEST_MODE=false
APP_KEY=
APP_URL=https://prumo-backend-x6w9.onrender.com
FRONTEND_URL=https://prumo.bernadin15-dev.workers.dev
SANCTUM_STATEFUL_DOMAINS=prumo.bernadin15-dev.workers.dev
# Preencher com IPs/CIDRs dos proxies confirmados pela hospedagem.
TRUSTED_PROXIES=

DB_CONNECTION=pgsql
# URL INTERNA atual, somente se serviço e banco estiverem na mesma conta/região.
# Laravel lê DB_URL, não DATABASE_URL. Não comite o valor real.
DB_URL=
# TLS obrigatório; verify-full não é suportado no endpoint interno Render.
DB_SSLMODE=require
DB_SSLROOTCERT=

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
LOG_LEVEL=warning
# Configure SMTP real separadamente para confirmação/recuperação de email.

# Gmail SMTP: exige hospedagem que permita saída 465 (Render Free bloqueia).
# Consulte EMAIL_CONFIRMATION.md. Preencher senha de app somente no painel.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USERNAME=bernadin15.dev@gmail.com
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=bernadin15.dev@gmail.com
# MAIL_FROM_NAME="PRUMA ESSENTIAL"
