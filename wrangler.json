{
  "name": "prumo",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/sanctum",
      "/sanctum/*"
    ]
  },
  "main": "cloudflare/worker.mjs",
  "keep_vars": true,
  "vars": {
    "LARAVEL_ORIGIN": "https://prumo-backend-x6w9.onrender.com",
    "FRONTEND_ORIGIN": "https://prumo.bernadin15-dev.workers.dev"
  }
}
