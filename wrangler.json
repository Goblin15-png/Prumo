{
  "name": "prumo",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/sanctum",
      "/sanctum/*"
    ]
  },
  "main": "cloudflare/worker.mjs",
  "keep_vars": true
}
